# Copy to backend/.env and fill in. Never commit .env.

# build.nvidia.com key (Nemotron). Required.
NVIDIA_API_KEY=
# Optional model overrides
# NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NEMOTRON_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# GitHub token that can read the repo's PRs (and comment, if POST_GITHUB_COMMENTS=true)
GITHUB_TOKEN=
POST_GITHUB_COMMENTS=false

# Dashboard
FRONTEND_ORIGINS=http://localhost:3000
TICKET_PREFIX=DZ
# TICKET_URL_BASE=https://yourteam.atlassian.net/browse

# Ticket Sharpener redundancy check: path to the repo to search
# REPO_PATH=../demo-repo
